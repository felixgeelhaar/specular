---
interface Props {
  version?: string;
}

const { version = "v2.0.0" } = Astro.props;
---

<section class="hero">
  <div class="container hero-content">
    <div class="hero-badge">
      <span>{version} Now Available</span>
    </div>

    <h1 class="hero-title">
      The <span class="highlight">Governance Layer</span><br />
      for AI Development
    </h1>

    <p class="hero-subtitle">
      Replace wild-west prompting with structured, policy-compliant workflows.
      Specular is the control plane for AI-driven development with drift detection,
      audit trails, and enterprise-grade policy enforcement.
    </p>

    <div class="hero-actions">
      <a href="#install" class="btn btn-primary">
        <span>brew install specular</span>
      </a>
      <a href="https://github.com/felixgeelhaar/specular/blob/main/docs/getting-started.md" class="btn btn-ghost">
        Read the Docs
      </a>
    </div>

    <!-- Terminal Preview - Full Workflow Demo -->
    <div class="terminal-preview">
      <div class="terminal-header">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">specular — zsh</span>
      </div>
      <div class="terminal-body">
        <div class="terminal-content">
          <!-- Step 1: Initialize -->
          <div class="terminal-line cmd-line line-1">
            <span class="prompt">$</span>
            <span class="command cmd-1">specular init</span>
          </div>
          <div class="terminal-line line-2">
            <span class="output"><span class="success">✓</span> Created .specular/spec.yaml</span>
          </div>
          <div class="terminal-line line-3">
            <span class="output"><span class="success">✓</span> Created .specular/policy.yaml</span>
          </div>
          <div class="terminal-line line-4">
            <span class="output"><span class="success">✓</span> Created .specular/router.yaml</span>
          </div>

          <!-- Step 2: Route List - Show Providers -->
          <div class="terminal-line cmd-line line-5">
            <span class="prompt">$</span>
            <span class="command cmd-5">specular route list</span>
          </div>
          <div class="terminal-line line-6">
            <span class="output section">=== AI Providers ===</span>
          </div>
          <div class="terminal-line line-7">
            <span class="output"><span class="success">✓</span> ollama (local) — llama3.2, qwen3</span>
          </div>
          <div class="terminal-line line-8">
            <span class="output"><span class="success">✓</span> claude (cli) — Claude Code 2.1.2</span>
          </div>
          <div class="terminal-line line-9">
            <span class="output"><span class="success">✓</span> anthropic — claude-sonnet-4, claude-haiku-3.5</span>
          </div>
          <div class="terminal-line line-10">
            <span class="output"><span class="success">✓</span> openai — gpt-4o, gpt-4o-mini</span>
          </div>

          <!-- Step 3: Spec Validate -->
          <div class="terminal-line cmd-line line-11">
            <span class="prompt">$</span>
            <span class="command cmd-11">specular spec validate</span>
          </div>
          <div class="terminal-line line-12">
            <span class="output"><span class="success">✓</span> Spec valid: 3 features, 12 tasks defined</span>
          </div>

          <!-- Step 4: Plan Create -->
          <div class="terminal-line cmd-line line-13">
            <span class="prompt">$</span>
            <span class="command cmd-13">specular plan create</span>
          </div>
          <div class="terminal-line line-14">
            <span class="output"><span class="success">✓</span> Plan generated: 12 tasks across 4 phases</span>
          </div>

          <!-- Step 5: Auto with Code Generation -->
          <div class="terminal-line cmd-line line-15">
            <span class="prompt">$</span>
            <span class="command cmd-15">specular auto "Build task manager"</span>
          </div>
          <div class="terminal-line line-16">
            <span class="output"><span class="success">✓</span> Generated spec: 3 features</span>
          </div>
          <div class="terminal-line line-17">
            <span class="output"><span class="success">✓</span> Generated code: cmd/main.go, internal/...</span>
          </div>
          <div class="terminal-line line-18">
            <span class="output"><span class="success">✓</span> Validated in Docker sandbox</span>
          </div>

          <!-- Step 6: Drift Check -->
          <div class="terminal-line cmd-line line-19">
            <span class="prompt">$</span>
            <span class="command cmd-19">specular drift check</span>
          </div>
          <div class="terminal-line line-20">
            <span class="output result"><span class="success">✅</span> No drift — spec, plan, code aligned</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 6rem;
    position: relative;
  }

  .hero-content {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
    background: var(--accent-cyan-glow);
    border: 1px solid var(--border-accent);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    margin-bottom: 2rem;
    animation: pulse-glow 3s ease-in-out infinite;
  }

  .hero-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--accent-cyan);
    border-radius: 50%;
    animation: blink 1.5s ease-in-out infinite;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .hero-title .highlight {
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-violet) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .hero-actions .btn {
    padding: 0.875rem 1.75rem;
    font-size: 0.875rem;
  }

  /* Terminal Preview */
  .terminal-preview {
    background: #0c0c0c;
    border: 1px solid var(--border-default);
    border-radius: 12px;
    overflow: hidden;
    max-width: 700px;
    margin: 0 auto;
    box-shadow:
      0 0 0 1px var(--border-subtle),
      0 20px 50px -10px rgba(0, 0, 0, 0.5),
      0 0 100px -20px var(--accent-cyan-glow);
    text-align: left;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ff5f56; }
  .terminal-dot.yellow { background: #ffbd2e; }
  .terminal-dot.green { background: #27ca40; }

  .terminal-title {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .terminal-body {
    padding: 1.25rem;
    background: #0c0c0c;
  }

  .terminal-content {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .terminal-line {
    opacity: 0;
    animation: fadeIn 0.3s ease forwards;
    white-space: nowrap;
    overflow: hidden;
  }

  .terminal-line.cmd-line {
    display: flex;
    align-items: center;
  }

  .prompt {
    color: var(--accent-cyan);
    margin-right: 0.5rem;
    flex-shrink: 0;
  }

  .command {
    color: #f7f7f7;
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
    width: 0;
    border-right: 2px solid var(--accent-cyan);
    animation: typing 0.5s steps(25, end) forwards, blink-caret 0.4s step-end 2 forwards;
  }

  @keyframes typing {
    from { width: 0; }
    to { width: 100%; border-right-color: transparent; }
  }

  @keyframes blink-caret {
    from, to { border-color: var(--accent-cyan); }
    50% { border-color: transparent; }
  }

  /* Command-specific typing delays (matches line fadeIn) */
  .cmd-1 { animation-delay: 0.2s, 0.2s; }
  .cmd-5 { animation-delay: 1.8s, 1.8s; }
  .cmd-11 { animation-delay: 3.8s, 3.8s; }
  .cmd-13 { animation-delay: 5.0s, 5.0s; }
  .cmd-15 { animation-delay: 6.2s, 6.2s; }
  .cmd-19 { animation-delay: 8.2s, 8.2s; }

  .output {
    color: #cccccc;
  }

  .output.section {
    color: #9cd9f0;
    margin-top: 0.5rem;
    display: block;
  }

  .output.box-top,
  .output.box-mid,
  .output.box-bot {
    color: var(--accent-cyan);
    display: block;
  }

  .output.result {
    margin-top: 0.75rem;
    display: block;
  }

  .success {
    color: #8eb33b;
  }

  .warning {
    color: #d0b03c;
  }

  /* Animation delays - Full Workflow */
  /* Step 1: specular init (cmd types 0.2-0.7s, output starts 0.8s) */
  .line-1 { animation-delay: 0.2s; }
  .line-2 { animation-delay: 0.9s; }
  .line-3 { animation-delay: 1.1s; }
  .line-4 { animation-delay: 1.3s; }

  /* Step 2: specular route list (cmd types 1.8-2.3s, output starts 2.4s) */
  .line-5 { animation-delay: 1.8s; }
  .line-6 { animation-delay: 2.5s; }
  .line-7 { animation-delay: 2.7s; }
  .line-8 { animation-delay: 2.9s; }
  .line-9 { animation-delay: 3.1s; }
  .line-10 { animation-delay: 3.3s; }

  /* Step 3: specular spec validate (cmd types 3.8-4.3s, output starts 4.4s) */
  .line-11 { animation-delay: 3.8s; }
  .line-12 { animation-delay: 4.5s; }

  /* Step 4: specular plan create (cmd types 5.0-5.5s, output starts 5.6s) */
  .line-13 { animation-delay: 5.0s; }
  .line-14 { animation-delay: 5.7s; }

  /* Step 5: specular build run --dry-run (cmd types 6.2-6.7s, output starts 6.8s) */
  .line-15 { animation-delay: 6.2s; }
  .line-16 { animation-delay: 6.9s; }
  .line-17 { animation-delay: 7.3s; }
  .line-18 { animation-delay: 7.7s; }

  /* Step 6: specular drift check (cmd types 8.2-8.7s, output starts 8.8s) */
  .line-19 { animation-delay: 8.2s; }
  .line-20 { animation-delay: 8.9s; }
</style>
