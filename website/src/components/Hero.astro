---
interface Props {
  version?: string;
}

const { version = "v1.9.0" } = Astro.props;
---

<section class="hero">
  <div class="container hero-content">
    <div class="hero-badge">
      <span>{version} Now Available</span>
    </div>

    <h1 class="hero-title">
      The <span class="highlight">Governance Layer</span><br />
      for AI Development
    </h1>

    <p class="hero-subtitle">
      Replace wild-west prompting with structured, policy-compliant workflows.
      Specular is the control plane for AI-driven development with drift detection,
      audit trails, and enterprise-grade policy enforcement.
    </p>

    <div class="hero-actions">
      <a href="#install" class="btn btn-primary">
        <span>brew install specular</span>
      </a>
      <a href="https://github.com/felixgeelhaar/specular/blob/main/docs/getting-started.md" class="btn btn-ghost">
        Read the Docs
      </a>
    </div>

    <!-- Terminal Preview - CSS Animation -->
    <div class="terminal-preview">
      <div class="terminal-header">
        <span class="terminal-dot red"></span>
        <span class="terminal-dot yellow"></span>
        <span class="terminal-dot green"></span>
        <span class="terminal-title">specular — zsh</span>
      </div>
      <div class="terminal-body">
        <div class="terminal-content">
          <!-- Command 1: specular doctor -->
          <div class="terminal-line line-1">
            <span class="prompt">$</span>
            <span class="command">specular doctor</span>
          </div>

          <!-- Output -->
          <div class="terminal-line line-2">
            <span class="output box-top">╔══════════════════════════════════════════════════════════════╗</span>
          </div>
          <div class="terminal-line line-3">
            <span class="output box-mid">║                    System Diagnostics                        ║</span>
          </div>
          <div class="terminal-line line-4">
            <span class="output box-bot">╚══════════════════════════════════════════════════════════════╝</span>
          </div>

          <div class="terminal-line line-5">
            <span class="output section">Container Runtime:</span>
          </div>
          <div class="terminal-line line-6">
            <span class="output"><span class="success">✓</span> Docker: Docker is available (version 29.1.3)</span>
          </div>

          <div class="terminal-line line-7">
            <span class="output section">AI Providers:</span>
          </div>
          <div class="terminal-line line-8">
            <span class="output"><span class="success">✓</span> ollama: ollama is available (local)</span>
          </div>
          <div class="terminal-line line-9">
            <span class="output"><span class="success">✓</span> anthropic: anthropic is available</span>
          </div>
          <div class="terminal-line line-10">
            <span class="output"><span class="success">✓</span> openai: openai is available</span>
          </div>

          <div class="terminal-line line-11">
            <span class="output section">Project Structure:</span>
          </div>
          <div class="terminal-line line-12">
            <span class="output"><span class="success">✓</span> Spec: specular.yaml loaded</span>
          </div>
          <div class="terminal-line line-13">
            <span class="output"><span class="success">✓</span> Policy: policy.yaml configured</span>
          </div>

          <div class="terminal-line line-14">
            <span class="output result"><span class="success">✅</span> System is healthy and ready to use!</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding-top: 6rem;
    position: relative;
  }

  .hero-content {
    text-align: center;
    max-width: 900px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent-cyan);
    background: var(--accent-cyan-glow);
    border: 1px solid var(--border-accent);
    padding: 0.5rem 1rem;
    border-radius: 100px;
    margin-bottom: 2rem;
    animation: pulse-glow 3s ease-in-out infinite;
  }

  .hero-badge::before {
    content: '';
    width: 6px;
    height: 6px;
    background: var(--accent-cyan);
    border-radius: 50%;
    animation: blink 1.5s ease-in-out infinite;
  }

  .hero-title {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 1.05;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }

  .hero-title .highlight {
    background: linear-gradient(135deg, var(--accent-cyan) 0%, var(--accent-violet) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .hero-subtitle {
    font-size: 1.25rem;
    color: var(--text-secondary);
    max-width: 600px;
    margin: 0 auto 2.5rem;
    line-height: 1.7;
  }

  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 4rem;
  }

  .hero-actions .btn {
    padding: 0.875rem 1.75rem;
    font-size: 0.875rem;
  }

  /* Terminal Preview */
  .terminal-preview {
    background: #0c0c0c;
    border: 1px solid var(--border-default);
    border-radius: 12px;
    overflow: hidden;
    max-width: 700px;
    margin: 0 auto;
    box-shadow:
      0 0 0 1px var(--border-subtle),
      0 20px 50px -10px rgba(0, 0, 0, 0.5),
      0 0 100px -20px var(--accent-cyan-glow);
    text-align: left;
  }

  .terminal-header {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.875rem 1rem;
    background: var(--bg-elevated);
    border-bottom: 1px solid var(--border-subtle);
  }

  .terminal-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .terminal-dot.red { background: #ff5f56; }
  .terminal-dot.yellow { background: #ffbd2e; }
  .terminal-dot.green { background: #27ca40; }

  .terminal-title {
    flex: 1;
    text-align: center;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  .terminal-body {
    padding: 1.25rem;
    background: #0c0c0c;
  }

  .terminal-content {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
  }

  .terminal-line {
    opacity: 0;
    animation: fadeIn 0.3s ease forwards;
    white-space: nowrap;
    overflow: hidden;
  }

  .prompt {
    color: var(--accent-cyan);
    margin-right: 0.5rem;
  }

  .command {
    color: #f7f7f7;
  }

  .output {
    color: #cccccc;
  }

  .output.section {
    color: #9cd9f0;
    margin-top: 0.5rem;
    display: block;
  }

  .output.box-top,
  .output.box-mid,
  .output.box-bot {
    color: var(--accent-cyan);
    display: block;
  }

  .output.result {
    margin-top: 0.75rem;
    display: block;
  }

  .success {
    color: #8eb33b;
  }

  .warning {
    color: #d0b03c;
  }

  /* Animation delays */
  .line-1 { animation-delay: 0.2s; }
  .line-2 { animation-delay: 0.8s; }
  .line-3 { animation-delay: 0.9s; }
  .line-4 { animation-delay: 1.0s; }
  .line-5 { animation-delay: 1.3s; }
  .line-6 { animation-delay: 1.5s; }
  .line-7 { animation-delay: 1.8s; }
  .line-8 { animation-delay: 2.0s; }
  .line-9 { animation-delay: 2.2s; }
  .line-10 { animation-delay: 2.4s; }
  .line-11 { animation-delay: 2.7s; }
  .line-12 { animation-delay: 2.9s; }
  .line-13 { animation-delay: 3.1s; }
  .line-14 { animation-delay: 3.5s; }
</style>
