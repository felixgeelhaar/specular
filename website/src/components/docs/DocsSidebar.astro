---
import { commandGroups, globalFlags } from '../../data/commands';
---

<aside class="docs-sidebar">
  <div class="sidebar-header">
    <a href="/specular/" class="sidebar-logo">
      <svg viewBox="0 0 32 32" fill="none">
        <path d="M16 2L2 9v14l14 7 14-7V9L16 2z" stroke="currentColor" stroke-width="2"/>
        <path d="M16 16v14M2 9l14 7 14-7" stroke="currentColor" stroke-width="2" opacity="0.5"/>
        <circle cx="16" cy="16" r="4" fill="currentColor"/>
      </svg>
      <span>Specular</span>
    </a>
    <span class="docs-badge">Docs</span>
  </div>

  <nav class="sidebar-nav">
    <div class="nav-section">
      <h3 class="nav-section-title">Command Reference</h3>
      <ul class="nav-list">
        {commandGroups.map((group) => (
          <li class="nav-item">
            <a href={`#${group.id}`} class="nav-link group-link" data-group={group.id}>
              <span class="nav-label">{group.name}</span>
              <span class="nav-count">{group.commands.length}</span>
            </a>
            <ul class="nav-sublist">
              {group.commands.map((cmd) => (
                <li>
                  <a
                    href={`#${cmd.name.replace(/\s+/g, '-').toLowerCase()}`}
                    class="nav-link cmd-link"
                  >
                    {cmd.name}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ))}
      </ul>
    </div>

    <div class="nav-section">
      <h3 class="nav-section-title">Global Options</h3>
      <ul class="nav-list">
        <li class="nav-item">
          <a href="#global-flags" class="nav-link">
            <span class="nav-label">Global Flags</span>
            <span class="nav-count">{globalFlags.length}</span>
          </a>
        </li>
      </ul>
    </div>
  </nav>

  <div class="sidebar-footer">
    <a href="https://github.com/felixgeelhaar/specular" class="footer-link" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16">
        <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
      </svg>
      <span>GitHub</span>
    </a>
    <span class="version">v1.9.0</span>
  </div>
</aside>

<style>
  .docs-sidebar {
    width: 280px;
    height: 100vh;
    position: fixed;
    top: 0;
    left: 0;
    background: var(--bg-primary);
    border-right: 1px solid var(--border-subtle);
    display: flex;
    flex-direction: column;
    z-index: 50;
    overflow: hidden;
  }

  .sidebar-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border-subtle);
    flex-shrink: 0;
  }

  .sidebar-logo {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: var(--text-primary);
  }

  .sidebar-logo svg {
    width: 24px;
    height: 24px;
  }

  .sidebar-logo span {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: -0.02em;
  }

  .docs-badge {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--accent-cyan);
    background: var(--accent-cyan-glow);
    border: 1px solid var(--border-accent);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .sidebar-nav {
    flex: 1;
    overflow-y: auto;
    padding: 1rem 0;
  }

  .nav-section {
    padding: 0 1rem;
    margin-bottom: 1.5rem;
  }

  .nav-section-title {
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 600;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 0 0.5rem;
    margin-bottom: 0.5rem;
  }

  .nav-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .nav-item {
    margin-bottom: 0.25rem;
  }

  .nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.5rem;
    border-radius: 6px;
    text-decoration: none;
    font-size: 0.875rem;
    color: var(--text-secondary);
    transition: all 0.15s;
  }

  .nav-link:hover {
    color: var(--text-primary);
    background: var(--bg-elevated);
  }

  .nav-link.active {
    color: var(--accent-cyan);
    background: var(--accent-cyan-glow);
  }

  .group-link {
    font-weight: 500;
  }

  .nav-label {
    flex: 1;
  }

  .nav-count {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-muted);
    background: var(--bg-elevated);
    padding: 0.125rem 0.375rem;
    border-radius: 4px;
  }

  .nav-sublist {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0.5rem 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.2s ease;
  }

  .nav-item:hover .nav-sublist,
  .nav-item:focus-within .nav-sublist {
    max-height: 500px;
  }

  .nav-sublist li {
    margin: 0;
  }

  .cmd-link {
    padding: 0.375rem 0.5rem 0.375rem 1.25rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--text-muted);
    position: relative;
  }

  .cmd-link::before {
    content: '';
    position: absolute;
    left: 0.5rem;
    top: 50%;
    transform: translateY(-50%);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--border-default);
    transition: background 0.15s;
  }

  .cmd-link:hover::before {
    background: var(--accent-cyan);
  }

  .sidebar-footer {
    padding: 1rem 1.5rem;
    border-top: 1px solid var(--border-subtle);
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-shrink: 0;
  }

  .footer-link {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 0.8125rem;
    transition: color 0.15s;
  }

  .footer-link:hover {
    color: var(--text-primary);
  }

  .version {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--text-muted);
  }

  /* Scrollbar styling */
  .sidebar-nav::-webkit-scrollbar {
    width: 4px;
  }

  .sidebar-nav::-webkit-scrollbar-track {
    background: transparent;
  }

  .sidebar-nav::-webkit-scrollbar-thumb {
    background: var(--border-subtle);
    border-radius: 2px;
  }

  .sidebar-nav::-webkit-scrollbar-thumb:hover {
    background: var(--border-default);
  }

  @media (max-width: 1024px) {
    .docs-sidebar {
      display: none;
    }
  }
</style>
