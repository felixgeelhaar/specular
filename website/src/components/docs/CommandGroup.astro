---
import type { CommandGroup } from '../../data/commands';
import CommandCard from './CommandCard.astro';

interface Props {
  group: CommandGroup;
}

const { group } = Astro.props;

const icons: Record<string, string> = {
  rocket: `<path d="M12.5 3.5l-3 9 3 3 3-3-3-9z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9.5 12.5l-3 3M14.5 12.5l3 3M12.5 15.5v5" stroke="currentColor" stroke-width="1.5"/>`,
  document: `<rect x="6" y="3" width="12" height="18" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 8h6M9 12h6M9 16h3" stroke="currentColor" stroke-width="1.5"/>`,
  map: `<rect x="3" y="5" width="18" height="14" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 5v14M15 5v14M3 10h18M3 14h18" stroke="currentColor" stroke-width="1.5"/>`,
  hammer: `<path d="M14 6l6 6-8 8-6-6 8-8z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M10 10l-6 6M4 20l4-4" stroke="currentColor" stroke-width="1.5"/>`,
  robot: `<rect x="6" y="8" width="12" height="12" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="9" cy="13" r="1.5" fill="currentColor"/><circle cx="15" cy="13" r="1.5" fill="currentColor"/><path d="M10 17h4M12 4v4M8 4h8" stroke="currentColor" stroke-width="1.5"/>`,
  warning: `<path d="M12 3L2 21h20L12 3z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M12 10v4M12 17v1" stroke="currentColor" stroke-width="2"/>`,
  cloud: `<path d="M6 18a4 4 0 1 1 0-8 6 6 0 0 1 12 0 4 4 0 0 1 0 8H6z" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  route: `<circle cx="5" cy="6" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="19" cy="18" r="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M7 6h4a4 4 0 0 1 4 4v4a4 4 0 0 0 4 4" stroke="currentColor" stroke-width="1.5" fill="none"/>`,
  shield: `<path d="M12 3L4 7v6c0 5 4 8 8 10 4-2 8-5 8-10V7l-8-4z" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 12l2 2 4-4" stroke="currentColor" stroke-width="2"/>`,
  lock: `<rect x="7" y="11" width="10" height="8" rx="2" stroke="currentColor" stroke-width="1.5" fill="none"/><path d="M9 11V8a3 3 0 0 1 6 0v3" stroke="currentColor" stroke-width="1.5" fill="none"/><circle cx="12" cy="15" r="1" fill="currentColor"/>`,
};
---

<section class="command-group" id={group.id}>
  <header class="group-header">
    <div class="group-icon">
      <svg viewBox="0 0 24 24" fill="none" set:html={icons[group.icon] || icons.document} />
    </div>
    <div class="group-info">
      <h2 class="group-name">{group.name}</h2>
      <p class="group-description">{group.description}</p>
    </div>
  </header>

  <div class="commands-list">
    {group.commands.map((command) => (
      <CommandCard command={command} />
    ))}
  </div>
</section>

<style>
  .command-group {
    scroll-margin-top: 100px;
  }

  .group-header {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .group-icon {
    width: 48px;
    height: 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--accent-cyan-glow);
    border: 1px solid var(--border-accent);
    border-radius: 12px;
    flex-shrink: 0;
  }

  .group-icon svg {
    width: 24px;
    height: 24px;
    color: var(--accent-cyan);
  }

  .group-info {
    flex: 1;
  }

  .group-name {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.25rem 0;
    letter-spacing: -0.02em;
  }

  .group-description {
    color: var(--text-secondary);
    font-size: 0.9375rem;
    margin: 0;
  }

  .commands-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  @media (max-width: 768px) {
    .group-header {
      flex-direction: column;
      align-items: flex-start;
    }

    .group-icon {
      width: 40px;
      height: 40px;
    }

    .group-icon svg {
      width: 20px;
      height: 20px;
    }
  }
</style>
