---
const methods = [
  {
    title: "Homebrew",
    icon: "package",
    command: "brew tap felixgeelhaar/specular && brew install specular"
  },
  {
    title: "Docker",
    icon: "docker",
    command: "docker pull ghcr.io/felixgeelhaar/specular:latest"
  },
  {
    title: "Binary",
    icon: "download",
    command: "curl -sSL https://specular.dev/install.sh | sh"
  },
  {
    title: "Go Install",
    icon: "go",
    command: "go install github.com/felixgeelhaar/specular@latest"
  }
];
---

<section class="install-section" id="install">
  <div class="container">
    <div class="section-header">
      <div class="section-label">// Get Started</div>
      <h2 class="section-title">One Command. Full Control.</h2>
      <p class="section-subtitle">
        Available on all major platforms. Pick your favorite.
      </p>
    </div>

    <div class="install-grid">
      {methods.map((method) => (
        <div class="install-card">
          <div class="install-card-header">
            <div class="install-card-icon">
              {method.icon === "package" && (
                <svg viewBox="0 0 24 24"><path d="M12 2L2 7l10 5 10-5-10-5z"/><path d="M2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
              )}
              {method.icon === "docker" && (
                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21,15 16,10 5,21"/></svg>
              )}
              {method.icon === "download" && (
                <svg viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7,10 12,15 17,10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
              )}
              {method.icon === "go" && (
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              )}
            </div>
            <span class="install-card-title">{method.title}</span>
          </div>
          <div class="install-code">
            <span class="install-command">{method.command}</span>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .install-section {
    padding: var(--section-padding) 0;
  }

  .install-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
    margin-top: 3rem;
  }

  .install-card {
    background: var(--bg-card);
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    padding: 1.5rem;
  }

  .install-card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }

  .install-card-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-elevated);
    border-radius: 8px;
  }

  .install-card-icon svg {
    width: 20px;
    height: 20px;
    stroke: var(--text-secondary);
    stroke-width: 1.5;
    fill: none;
  }

  .install-card-title {
    font-family: var(--font-display);
    font-weight: 600;
  }

  .install-code {
    background: var(--bg-void);
    border: 1px solid var(--border-subtle);
    border-radius: 8px;
    padding: 1rem;
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    color: var(--accent-cyan);
    overflow-x: auto;
    position: relative;
  }

  .install-code::before {
    content: '$';
    color: var(--text-muted);
    margin-right: 0.5rem;
  }

  .install-command {
    user-select: all;
  }
</style>
