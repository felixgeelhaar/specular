---
const steps = [
  { number: 1, label: "Specify", desc: "Define requirements in YAML", icon: "document" },
  { number: 2, label: "Validate", desc: "Policy enforcement", icon: "shield" },
  { number: 3, label: "Plan", desc: "AI task decomposition", icon: "grid" },
  { number: 4, label: "Approve", desc: "Human-in-the-loop", icon: "check" },
  { number: 5, label: "Generate", desc: "AI code generation", icon: "code" },
  { number: 6, label: "Monitor", desc: "Drift detection", icon: "alert" },
];
---

<section class="workflow-section" id="workflow">
  <div class="container">
    <div class="section-header">
      <div class="section-label">// How It Works</div>
      <h2 class="section-title">From Spec to Ship. Audited.</h2>
      <p class="section-subtitle">
        Six steps. Zero surprises. Every action validated, logged, and traceable.
      </p>
    </div>

    <div class="workflow-pipeline">
      {steps.map((step, index) => (
        <>
          <div class="workflow-step">
            <div class="workflow-icon">
              <span class="workflow-step-number">{step.number}</span>
              {step.icon === "document" && (
                <svg viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14,2 14,8 20,8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
              )}
              {step.icon === "shield" && (
                <svg viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
              )}
              {step.icon === "grid" && (
                <svg viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" ry="2"/><line x1="3" y1="9" x2="21" y2="9"/><line x1="9" y1="21" x2="9" y2="9"/></svg>
              )}
              {step.icon === "check" && (
                <svg viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22,4 12,14.01 9,11.01"/></svg>
              )}
              {step.icon === "terminal" && (
                <svg viewBox="0 0 24 24"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/></svg>
              )}
              {step.icon === "code" && (
                <svg viewBox="0 0 24 24"><polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/></svg>
              )}
              {step.icon === "alert" && (
                <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
              )}
            </div>
            <span class="workflow-label">{step.label}</span>
            <span class="workflow-desc">{step.desc}</span>
          </div>
          {index < steps.length - 1 && <div class="workflow-connector" />}
        </>
      ))}
    </div>
  </div>
</section>

<style>
  .workflow-section {
    padding: var(--section-padding) 0;
    position: relative;
  }

  .workflow-pipeline {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0;
    flex-wrap: wrap;
    padding: 2rem 0;
  }

  .workflow-step {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    position: relative;
  }

  .workflow-icon {
    width: 80px;
    height: 80px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--bg-card);
    border: 2px solid var(--border-default);
    border-radius: 16px;
    margin-bottom: 1rem;
    position: relative;
    transition: all 0.3s ease;
  }

  .workflow-step:hover .workflow-icon {
    border-color: var(--accent-cyan);
    box-shadow: 0 0 30px var(--accent-cyan-glow);
    transform: translateY(-4px);
  }

  .workflow-icon svg {
    width: 32px;
    height: 32px;
    stroke: var(--accent-cyan);
    stroke-width: 1.5;
    fill: none;
  }

  .workflow-step-number {
    position: absolute;
    top: -8px;
    right: -8px;
    width: 24px;
    height: 24px;
    background: var(--accent-cyan);
    color: var(--bg-void);
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 600;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .workflow-label {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .workflow-desc {
    font-size: 0.75rem;
    color: var(--text-muted);
    max-width: 100px;
  }

  .workflow-connector {
    width: 60px;
    height: 2px;
    background: linear-gradient(90deg, var(--border-default) 0%, var(--accent-cyan) 50%, var(--border-default) 100%);
    position: relative;
    margin: 0 -10px;
    margin-bottom: 3rem;
  }

  .workflow-connector::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    transform: translateY(-50%);
    border: 5px solid transparent;
    border-left-color: var(--accent-cyan);
  }

  @media (max-width: 768px) {
    .workflow-pipeline {
      flex-direction: column;
      gap: 1rem;
    }

    .workflow-connector {
      width: 2px;
      height: 40px;
      margin: -10px 0;
      background: linear-gradient(180deg, var(--border-default) 0%, var(--accent-cyan) 50%, var(--border-default) 100%);
    }

    .workflow-connector::after {
      right: 50%;
      top: auto;
      bottom: 0;
      transform: translateX(50%);
      border: 5px solid transparent;
      border-top-color: var(--accent-cyan);
      border-left-color: transparent;
    }
  }
</style>
