[5.017, "o", "\r\n╔══════════════════════════════════════════════════════════════╗\r\n║           Specular Project Initialization                    ║\r\n╚══════════════════════════════════════════════════════════════╝\r\n\r\nℹ  Skipping context detection (--no-detect)\r\n"]
[0.000, "o", "\r\n✓ Created .specular directory at /tmp/specular-demo/.specular\r\n"]
