[0.000, "o", "✓ Created settings.json\r\n\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n  ✨ Project Initialized Successfully!\r\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\r\n\r\nConfiguration files created:\r\n  • .specular/router.yaml    - AI provider routing\r\n  • .specular/policy.yaml    - Security policies\r\n  • .specular/spec.yaml      - Product specification\r\n  • .specular/settings.json  - Project settings\r\n"]
[0.000, "o", "\r\nProvider Strategy: manual\r\nGovernance Level: L2\r\n\r\n"]
[0.000, "o", "Next steps:\r\n\r\n  1. Check your system health:\r\n     $ specular doctor\r\n"]
[0.000, "o", "\r\n"]
[0.000, "o", "  2. Review your configuration:\r\n     $ cat .specular/router.yaml\r\n"]
[0.000, "o", "     $ specular route show\r\n"]
[0.000, "o", "\r\n  3. Create your spec (interactive):\r\n"]
[0.000, "o", "     $ specular interview\r\n"]
[0.000, "o", "\r\n  4. Or edit the spec template:\r\n"]
[0.000, "o", "     $ vim .specular/spec.yaml\r\n"]
[0.000, "o", "\r\n  5. Generate a plan:\r\n     $ specular plan\r\n\r\n  6. Execute your plan:\r\n     $ specular build\r\n"]
[0.000, "o", "\r\n"]
