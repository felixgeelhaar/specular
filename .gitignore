# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
/ai-dev
/specular
/specular-*
/guardrail
test_register.sh

# Compiled provider wrappers and example plugins. These are built on demand
# (scripts/package-cli-wrappers.sh writes to build/providers/; the plugin
# README builds the example before installing it). Go binaries have no file
# extension, so the *.exe/*.so/*.dylib patterns above cannot match them —
# they must be ignored by path.
/providers/*/*-provider
/examples/plugins/slack-notifier/slack-notifier

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
*.out
coverage.txt
coverage.html

# Dependency directories
vendor/

# Go workspace file
go.work

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# Claude Code runtime files
.claude/

# Specular specific
.specular/*
!.specular/*.example
.aidv/*
!.aidv/*.example
*.lock.json
plan.json
drift.sarif

# Temporary files
tmp/
temp/
*.tmp

# Logs
*.log
logs/

# Environment files
.env
.env.local

# Build artifacts
dist/
build/
bin/

# Node.js (website)
node_modules/
website/dist/
website/.astro/

# Sensitive internal documents (IP)
docs/prd.md
docs/*roadmap*.md
docs/*strategy*.md
RELEASE_PLAN*.md
docs/tech_design.md
AGENTS.md
