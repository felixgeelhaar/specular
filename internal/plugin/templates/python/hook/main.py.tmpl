import json
import sys
from typing import Any, Dict

VERSION = "{{.Version}}"


def health_check() -> Dict[str, str]:
    """Return health status."""
    return {"status": "healthy", "version": VERSION}


def execute_hook(data: Dict[str, Any], config: Dict[str, Any]) -> Dict[str, Any]:
    """Execute hook logic.

    Args:
        data: Request data containing 'event' and event-specific data
        config: Plugin configuration from manifest

    Returns:
        Hook result with 'executed' and optional 'data'
    """
    event = data.get("event", "")

    # TODO: Implement your hook logic here
    # Example: result = handle_event(event, data, config)

    return {
        "executed": True,
        "data": {},
    }


def main() -> None:
    """Main entry point - reads JSON from stdin, writes JSON to stdout."""
    for line in sys.stdin:
        try:
            request = json.loads(line.strip())
            action = request.get("action", "execute")

            if action == "health":
                result = health_check()
            elif action in ("pre", "post", "execute"):
                result = execute_hook(
                    request.get("data", {}),
                    request.get("config", {})
                )
            else:
                print(json.dumps({"success": False, "error": f"Unknown action: {action}"}))
                continue

            print(json.dumps({"success": True, "result": result}))

        except json.JSONDecodeError as e:
            print(json.dumps({"success": False, "error": f"Invalid JSON: {e}"}))
        except Exception as e:
            print(json.dumps({"success": False, "error": str(e)}))

        sys.stdout.flush()


if __name__ == "__main__":
    main()
