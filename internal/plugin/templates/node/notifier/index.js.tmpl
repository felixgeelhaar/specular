/**
 * {{.Name}} - A Specular notifier plugin
 */

const readline = require('readline');

const VERSION = '{{.Version}}';

/**
 * Health check response
 * @returns {Object} Health status
 */
function healthCheck() {
  return { status: 'healthy', version: VERSION };
}

/**
 * Send notification
 * @param {Object} data - Request data
 * @param {Object} config - Plugin configuration
 * @returns {Promise<Object>} Notifier result
 */
async function notify(data, config) {
  const message = data.message || '';
  const channel = data.channel || '';

  // TODO: Implement your notification logic here
  // Example: const messageId = await sendNotification(message, channel, config);

  return {
    sent: true,
    message_id: 'msg-001',
    channel,
  };
}

/**
 * Main entry point
 */
async function main() {
  const rl = readline.createInterface({
    input: process.stdin,
    output: process.stdout,
    terminal: false,
  });

  for await (const line of rl) {
    try {
      const request = JSON.parse(line);
      const action = request.action || 'notify';

      let result;
      if (action === 'health') {
        result = healthCheck();
      } else if (['notify', 'send'].includes(action)) {
        result = await notify(request.data || {}, request.config || {});
      } else {
        console.log(JSON.stringify({ success: false, error: `Unknown action: ${action}` }));
        continue;
      }

      console.log(JSON.stringify({ success: true, result }));

    } catch (error) {
      console.log(JSON.stringify({ success: false, error: error.message }));
    }
  }
}

main().catch(console.error);
